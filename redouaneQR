<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Redouane Barber QR Code</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f5f3ef;
      font-family: Arial, sans-serif;
    }

    .qr-box {
      padding: 28px;
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 15px 45px rgba(0, 0, 0, 0.12);
      text-align: center;
    }

    #qrcode {
      display: inline-block;
      padding: 20px;
      background: #ffffff;
      border-radius: 12px;
    }

    #qrcode img,
    #qrcode canvas {
      display: block;
      width: 320px !important;
      height: 320px !important;
    }

    .qr-title {
      margin: 18px 0 5px;
      color: #171717;
      font-size: 22px;
      font-weight: 700;
    }

    .qr-text {
      margin: 0;
      color: #777;
      font-size: 14px;
    }

    @media (max-width: 420px) {
      #qrcode img,
      #qrcode canvas {
        width: 270px !important;
        height: 270px !important;
      }

      .qr-box {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

  <div class="qr-box">

    <div id="qrcode"></div>

    <div class="qr-title">Redouane Barber</div>
    <p class="qr-text">Scan to book your appointment</p>

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <script>
    new QRCode(document.getElementById("qrcode"), {
      text: "https://benjellounan.github.io/QR-Code-redouane/redouane-barber.html#top",
      width: 1000,
      height: 1000,
      colorDark: "#000000",
      colorLight: "#ffffff",
      correctLevel: QRCode.CorrectLevel.H
    });
  </script>

</body>
</html>
